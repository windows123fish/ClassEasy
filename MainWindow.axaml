<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClassEasy.MainWindow"
        xmlns:vm="using:ClassEasy.ViewModels"
        xmlns:ctrl="using:ClassEasy.Controls"
        x:DataType="vm:MainWindowViewModel"
        Title="ClassEasy"
        SystemDecorations="None"
        Background="Transparent"
        CanResize="False"
        FontFamily="Microsoft YaHei UI, Segoe UI, Noto Sans SC, sans-serif"
        Width="900"
        Height="48"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    <Border x:Name="RootBorder"
            ClipToBounds="True"
            PointerEntered="RootBorder_PointerEntered"
            PointerPressed="RootBorder_PointerPressed"
            PointerMoved="RootBorder_PointerMoved"
            PointerReleased="RootBorder_PointerReleased"
            PointerCaptureLost="RootBorder_PointerCaptureLost">

        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity"
                                Duration="0:0:0.25"
                                Easing="CubicEaseOut" />
            </Transitions>
        </Border.Transitions>
        <Grid>
            <!-- 背景：顶部微亮到底部微暗，模拟光线折射 -->
            <Border x:Name="AcrylicBackground">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#D0262626" />
                        <GradientStop Offset="1" Color="#B31A1A1A" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <!-- 顶部 1px 高光线：模拟光线射入玻璃 -->
            <Border x:Name="TopHighlight"
                    Height="1"
                    VerticalAlignment="Top"
                    Background="#22FFFFFF" />
            <!-- 内容 -->
            <StackPanel x:Name="ContentPanel"
                        Orientation="Horizontal"
                        Spacing="16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">

        <!-- 左区：时间 + 日期 -->
        <StackPanel Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
            <TextBlock Text="{Binding CurrentTime}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding CurrentDate}"
                       FontSize="12"
                       Foreground="White"
                       Opacity="0.5"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- 分隔线 -->
        <Border Width="1"
                Height="20"
                Background="#22FFFFFF"
                VerticalAlignment="Center"
                IsVisible="{Binding ShowDivider}" />

        <!-- 中区：课程流（有课时） -->
        <ItemsControl ItemsSource="{Binding LessonFlow}"
                      VerticalAlignment="Center"
                      IsVisible="{Binding HasLessonsToday}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"
                                Spacing="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ctrl:LessonCard DataContext="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 中区：状态文本（无课时） -->
        <StackPanel Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center"
                    IsVisible="{Binding !HasLessonsToday}">
            <TextBlock Text="{Binding MiddleText}"
                       FontSize="14"
                       Foreground="White"
                       Opacity="0.85"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- 右区：天气 -->
        <StackPanel Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
            <TextBlock Text="{Binding WeatherTemp}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="White"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding WeatherDesc}"
                       FontSize="12"
                       Foreground="White"
                       Opacity="0.55"
                       VerticalAlignment="Center" />
        </StackPanel>

            </StackPanel>
        </Grid>
    </Border>
</Window>
