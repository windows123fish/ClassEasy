<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClassEasy.MainWindow"
        xmlns:vm="using:ClassEasy.ViewModels"
        x:DataType="vm:MainWindowViewModel"
        Title="ClassEasy"
        SystemDecorations="None"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        ExtendClientAreaChromeHints="NoChrome"
        CanResize="False"
        Width="540"
        MinWidth="420"
        Height="68"
        Topmost="True"
        WindowStartupLocation="Manual">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <!-- 药丸卡片容器：ClipToBounds=False 保证阴影不被裁剪 -->
    <Border x:Name="CardBorder"
            Background="#D81A1A1A"
            CornerRadius="34"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="20,12"
            ClipToBounds="False"
            BoxShadow="0 8 32 0 #88000000"
            PointerEntered="CardBorder_PointerEntered"
            PointerExited="CardBorder_PointerExited">

        <Border.Transitions>
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform"
                                                Duration="0:0:0.2"
                                                Easing="QuadraticEaseOut" />
                <BoxShadowsTransition Property="BoxShadow"
                                      Duration="0:0:0.2"
                                      Easing="QuadraticEaseOut" />
            </Transitions>
        </Border.Transitions>

        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">

            <!-- 左列：时间 + 日期 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrentTime}"
                           FontSize="22" FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding CurrentDate}"
                           FontSize="13" FontWeight="Normal"
                           Foreground="White" Opacity="0.55"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- 中列：状态文本 + ℹ 图标（居中） -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}"
                           FontSize="14"
                           Foreground="White" Opacity="0.85"
                           VerticalAlignment="Center" />
                <!-- 用 Path 绘制 info 图标，避免 Win7 缺少 emoji 字体导致无法渲染 -->
                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"
                      Width="12" Height="12" Stretch="Uniform"
                      Fill="White" Opacity="0.25"
                      VerticalAlignment="Center" />
            </StackPanel>

            <!-- 右列：温度 + 天气描述 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding WeatherTemp}"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding WeatherDesc}"
                           FontSize="13"
                           Foreground="White" Opacity="0.6"
                           VerticalAlignment="Center" />
            </StackPanel>

        </Grid>
    </Border>
</Window>
