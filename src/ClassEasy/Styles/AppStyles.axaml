<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <!-- ============================ 主题色词典 ============================ -->
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F00B0F14" />
          <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8C5B6470" />
          <SolidColorBrush x:Key="IslandBgBrush" Color="#59FFFFFF" />
          <SolidColorBrush x:Key="IslandBorderBrush" Color="#40FFFFFF" />
          <SolidColorBrush x:Key="CardBgBrush" Color="#4DFFFFFF" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#24FFFFFF" />
          <SolidColorBrush x:Key="ToggleBgBrush" Color="#3DF2F5FA" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F0F3F6FA" />
          <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8C9AA3AE" />
          <SolidColorBrush x:Key="IslandBgBrush" Color="#6B1E242E" />
          <SolidColorBrush x:Key="IslandBorderBrush" Color="#2EFFFFFF" />
          <SolidColorBrush x:Key="CardBgBrush" Color="#29FFFFFF" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#1AFFFFFF" />
          <SolidColorBrush x:Key="ToggleBgBrush" Color="#3D2A303B" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- 强调色（跟随 FluentAvaloniaTheme 的 SystemAccentColor，运行时可被 CustomAccentColor 刷新） -->
      <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource SystemAccentColor}" />
      <SolidColorBrush x:Key="AccentTintBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.14" />
      <SolidColorBrush x:Key="AccentDeepBrush" Color="{DynamicResource SystemAccentColorDark1}" />

      <!-- ============================ MDI 图标 ============================ -->
      <StreamGeometry x:Key="MdiClock">M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M16.2,16.2L11,13V7H12.5V12.2L17,14.9L16.2,16.2Z</StreamGeometry>
      <StreamGeometry x:Key="MdiCalendar">M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z</StreamGeometry>
      <StreamGeometry x:Key="MdiBookOpenVariant">M12,21.5C10.65,20.65 8.2,20 6,20C3.8,20 1.35,20.65 0,21.5V4C1.35,3.15 3.8,2.5 6,2.5C8.2,2.5 10.65,3.15 12,4C13.35,3.15 15.8,2.5 18,2.5C20.2,2.5 22.65,3.15 24,4V21.5C22.65,20.65 20.2,20 18,20C15.8,20 13.35,20.65 12,21.5M12,6C10.55,5.16 8.45,4.5 6,4.5V18.5C8.45,18.5 10.55,19.16 12,20V6Z</StreamGeometry>
      <StreamGeometry x:Key="MdiChevronDown">M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z</StreamGeometry>
      <StreamGeometry x:Key="MdiAlert">M13,14H11V9H13M13,18H11V16H13M1,21H23L12,2L1,21Z</StreamGeometry>
      <StreamGeometry x:Key="MdiWeatherSunny">M12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,2L14.39,5.42C13.65,5.15 12.84,5 12,5C11.16,5 10.35,5.15 9.61,5.42L12,2M3.34,7L7.59,6.62C7.19,7.22 6.87,7.88 6.67,8.59L3.34,7M3.34,17L6.67,15.41C6.87,16.12 7.19,16.78 7.59,17.38L3.34,17M20.66,17L16.41,17.38C16.81,16.78 17.13,16.12 17.33,15.41L20.66,17M20.66,7L17.33,8.59C17.13,7.88 16.81,7.22 16.41,6.62L20.66,7M12,22L9.61,18.58C10.35,18.85 11.16,19 12,19C12.84,19 13.65,18.85 14.39,18.58L12,22Z</StreamGeometry>
      <StreamGeometry x:Key="MdiWeatherCloud">M19.35,10.04C18.67,6.59 15.64,4 12,4C9.11,4 6.6,5.64 5.35,8.04C2.34,8.36 0,10.91 0,14A6,6 0 0,0 6,20H19A5,5 0 0,0 24,15C24,12.36 21.95,10.22 19.35,10.04M19,18H6A4,4 0 0,1 2,14C2,11.95 3.53,10.24 5.56,10.03L6.63,9.92L7.13,8.97C8.08,7.14 9.94,6 12,6C14.62,6 16.88,7.86 17.39,10.43L17.69,11.93L19.22,12.04C20.78,12.14 22,13.45 22,15A3,3 0 0,1 19,18Z</StreamGeometry>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ============================ 灵动岛 ============================ -->
  <Style Selector="Border.island">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- 顶栏组件（ClassIsland 式：透明无边框，竖线分隔，内容直接排在毛玻璃条上） -->
  <Style Selector="Border.capsule">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <!-- 时钟冒号闪烁：仅调透明度（占位恒定不跳动）；未开启闪烁时无任何效果 -->
  <Style Selector="TextBlock.colon">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="TextBlock.colon.blink">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <!-- 课程流：课间竖分隔线（ClassIsland LessonControlSeparator） -->
  <Style Selector="Rectangle.flowsep">
    <Setter Property="Width" Value="2" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="Opacity" Value="0.55" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- 课程流：当前课倒计时圆条（ClassIsland 强调色描边样式） -->
  <Style Selector="Border.countdown">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="7,1.5" />
  </Style>

  <!-- 课程流：已结束课程淡化 -->
  <Style Selector="StackPanel.flowitem">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="StackPanel.flowitem.past">
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <!-- 日视图课程卡 -->
  <Style Selector="Border.lesson">
    <Setter Property="Width" Value="126" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.lesson.current">
    <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.lesson.past">
    <Setter Property="Opacity" Value="0.42" />
  </Style>

  <!-- 周视图列与迷你卡 -->
  <Style Selector="Border.daycol">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="7,7" />
    <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.daycol.today">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
  </Style>

  <Style Selector="Border.minilesson">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Margin" Value="0,3,0,0" />
    <Setter Property="Background" Value="{DynamicResource ToggleBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.minilesson.current">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
  </Style>
  <Style Selector="Border.minilesson.past">
    <Setter Property="Opacity" Value="0.42" />
  </Style>

  <!-- 视图切换按钮 -->
  <Style Selector="ToggleButton.viewtoggle">
    <Setter Property="Padding" Value="18,4" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{DynamicResource ToggleBgBrush}" />
    <Setter Property="MinHeight" Value="26" />
  </Style>

  <!-- 展开按钮 -->
  <Style Selector="Button.expand">
    <Setter Property="Background" Value="{DynamicResource ToggleBgBrush}" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.expand.expanded">
    <Setter Property="RenderTransform" Value="rotate(180deg)" />
  </Style>

  <!-- 提醒 Toast -->
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource AccentDeepBrush}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="BoxShadow" Value="0 4 16 0 #33000000" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
    <Setter Property="RenderTransform" Value="translateY(-4px)" />
    <Setter Property="Opacity" Value="0.95" />
  </Style>

  <!-- 文本工具类 -->
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
  </Style>
  <Style Selector="TextBlock.todayname">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
  </Style>
</Styles>
