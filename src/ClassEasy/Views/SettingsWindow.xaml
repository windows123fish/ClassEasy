<Window x:Class="ClassEasy.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClassEasy 设置"
        WindowStartupLocation="CenterScreen"
        Width="380"
        SizeToContent="Height"
        Background="#F7FAFC"
        FontFamily="{DynamicResource Font.AppFamily}">
    <StackPanel Margin="20">
        <TextBlock Text="天气城市" FontWeight="Bold" Foreground="#2D3748" />
        <TextBox x:Name="CityBox" Margin="0,6,0,0" Padding="4" />

        <TextBlock Text="主题" FontWeight="Bold" Foreground="#2D3748" Margin="0,18,0,0" />
        <ComboBox x:Name="ThemeCombo" Margin="0,6,0,0" Padding="4" />

        <TextBlock Text="字体" FontWeight="Bold" Foreground="#2D3748" Margin="0,18,0,0" />
        <ComboBox x:Name="FontCombo" Margin="0,6,0,0" Padding="4" />

        <TextBlock Text="时间字号" FontWeight="Bold" Foreground="#2D3748" Margin="0,18,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Slider x:Name="FontSizeSlider" Minimum="24" Maximum="72" Width="250" VerticalAlignment="Center" />
            <TextBlock x:Name="FontSizeValue" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#4A6CF7" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="取 消" Width="80" Padding="0,6" Click="Cancel_Click" />
            <Button Content="保 存" Width="80" Padding="0,6" Margin="10,0,0,0"
                    Background="#4A6CF7" Foreground="White" BorderThickness="0" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>