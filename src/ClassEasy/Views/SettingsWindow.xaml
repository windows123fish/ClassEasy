<Window x:Class="ClassEasy.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClassEasy 设置"
        WindowStartupLocation="CenterScreen"
        Width="420"
        SizeToContent="Height"
        Background="#F7FAFC"
        FontFamily="{DynamicResource Font.AppFamily}">
    <StackPanel Margin="20">
        <!-- 保存成功提示条 -->
        <Border x:Name="ToastBar" Background="#48BB78" CornerRadius="4"
                Padding="12,8" Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock Text="设置更改成功" Foreground="White" FontWeight="Bold"
                       HorizontalAlignment="Center" />
        </Border>

        <TextBlock Text="天气城市" FontWeight="Bold" Foreground="#2D3748" />
        <TextBox x:Name="CityBox" Margin="0,6,0,0" Padding="4" />

        <TextBlock Text="天气数据源" FontWeight="Bold" Foreground="#2D3748" Margin="0,18,0,0" />
        <ComboBox x:Name="WeatherSourceCombo" Margin="0,6,0,0" Padding="4" />

        <TextBlock Text="主题" FontWeight="Bold" Foreground="#2D3748" Margin="0,18,0,0" />
        <ComboBox x:Name="ThemeCombo" Margin="0,6,0,0" Padding="4" />

        <TextBlock Text="字体" FontWeight="Bold" Foreground="#2D3748" Margin="0,18,0,0" />
        <ComboBox x:Name="FontCombo" Margin="0,6,0,0" Padding="4" />

        <TextBlock Text="时间字号" FontWeight="Bold" Foreground="#2D3748" Margin="0,18,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Slider x:Name="FontSizeSlider" Minimum="24" Maximum="72" Width="250" VerticalAlignment="Center" />
            <TextBlock x:Name="FontSizeValue" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#4A6CF7" />
        </StackPanel>

        <TextBlock Text="磨砂背景透明度" FontWeight="Bold" Foreground="#2D3748" Margin="0,18,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Slider x:Name="BackdropSlider" Minimum="0.20" Maximum="1.0" TickFrequency="0.05"
                    IsSnapToTickEnabled="True" Width="250" VerticalAlignment="Center" />
            <TextBlock x:Name="BackdropValue" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#4A6CF7" />
        </StackPanel>

        <TextBlock Text="NTP 同步间隔" FontWeight="Bold" Foreground="#2D3748" Margin="0,18,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Slider x:Name="NtpIntervalSlider" Minimum="1" Maximum="120" TickFrequency="1"
                    IsSnapToTickEnabled="True" Width="250" VerticalAlignment="Center" />
            <TextBlock x:Name="NtpIntervalValue" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#4A6CF7" />
        </StackPanel>
        <TextBlock x:Name="NtpStatusText" FontSize="12" Foreground="#718096" Margin="0,4,0,0"
                   TextWrapping="Wrap" />

        <!-- 高级设置面板：开发者模式下才显示 -->
        <Border x:Name="AdvancedSection" BorderBrush="#CBD5E0" BorderThickness="1"
                CornerRadius="6" Padding="12" Margin="0,18,0,0" Background="#FFFFFF"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="高级设置（开发者模式）" FontWeight="Bold" Foreground="#2D3748" />

                <TextBlock Text="自定义 NTP 服务器（逗号或换行分隔）" FontWeight="Bold" Foreground="#2D3748" Margin="0,12,0,0" />
                <TextBox x:Name="CustomNtpBox" Margin="0,6,0,0" Padding="4"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                         VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="日志级别" FontWeight="Bold" Foreground="#2D3748" Margin="0,12,0,0" />
                <ComboBox x:Name="LogLevelCombo" Margin="0,6,0,0" Padding="4" />

                <Button Content="强制刷新天气" Click="ForceRefreshWeather_Click"
                        Margin="0,12,0,0" Padding="6,4" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <!-- 开发者模式开关 + 重启提示 -->
        <CheckBox x:Name="ShowHolidayCheck" Content="显示节假日" Margin="0,18,0,0" />
        <CheckBox x:Name="AutoStartCheck" Content="开机自动启动" Margin="0,12,0,0" />

        <CheckBox x:Name="DevModeCheck" Content="开发者模式" Margin="0,18,0,0"
                  Checked="DevModeCheck_Changed" Unchecked="DevModeCheck_Changed" />
        <TextBlock x:Name="DevModeWarning" Text="⚠ 切换后需重启 ClassEasy 才会生效。"
                   Foreground="#E53E3E" FontSize="12" Margin="22,4,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="取 消" Width="80" Padding="0,6" Click="Cancel_Click" />
            <Button Content="保 存" Width="80" Padding="0,6" Margin="10,0,0,0"
                    Background="#4A6CF7" Foreground="White" BorderThickness="0" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
