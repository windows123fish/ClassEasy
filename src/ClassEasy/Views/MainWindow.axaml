<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClassEasy.ViewModels"
        x:Class="ClassEasy.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ClassEasy"
        Width="820" Height="68"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="False"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI">

  <!-- 展开收起时窗口高度平滑过渡 -->
  <Window.Transitions>
    <Transitions>
      <DoubleTransition Property="Height" Duration="0:0:0.25" Easing="CubicEaseOut" />
    </Transitions>
  </Window.Transitions>

  <Window.DataTemplates>
    <!-- ============ 时间组件：ClassIsland 大字时钟（冒号常显）+ 日期小字 ============ -->
    <DataTemplate DataType="{x:Type vm:ClockCapsuleViewModel}" x:DataType="vm:ClockCapsuleViewModel">
      <Border Classes="capsule" ToolTip.Tip="拖拽可调整组件顺序"
              PointerPressed="Capsule_PointerPressed"
              PointerMoved="Capsule_PointerMoved"
              PointerReleased="Capsule_PointerReleased"
              PointerCaptureLost="Capsule_PointerCaptureLost">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding HourText}" FontSize="25" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock Text=":" FontSize="25" FontWeight="SemiBold" Margin="1,0"
                       Classes.colon="True"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock Text="{Binding MinuteText}" FontSize="25" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="{Binding DateText}" FontSize="12.5" FontWeight="Medium"
                         Foreground="{DynamicResource PrimaryTextBrush}" />
              <TextBlock Text="{Binding WeekText}" FontSize="12.5" Classes="secondary" />
            </StackPanel>
            <TextBlock Text="{Binding HolidayText}" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                       IsVisible="{Binding HasHoliday}" />
          </StackPanel>
          <Path Data="{StaticResource MdiAlert}" Fill="#FFE8A33D"
                Width="13" Height="13" VerticalAlignment="Top"
                IsVisible="{Binding HasNtpWarning}" ToolTip.Tip="{Binding NtpWarning}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- ============ 课程流组件：今日课程横向大字排布（ClassIsland 核心样式） ============ -->
    <DataTemplate DataType="{x:Type vm:CurrentClassCapsuleViewModel}" x:DataType="vm:CurrentClassCapsuleViewModel">
      <Border Classes="capsule" ToolTip.Tip="拖拽可调整组件顺序"
              PointerPressed="Capsule_PointerPressed"
              PointerMoved="Capsule_PointerMoved"
              PointerReleased="Capsule_PointerReleased"
              PointerCaptureLost="Capsule_PointerCaptureLost">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ItemsControl ItemsSource="{Binding $parent[Window].((vm:MainViewModel)DataContext).TodayLessons}"
                        ItemTemplate="{StaticResource FlowLessonTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <TextBlock Text="今天没有课程" FontSize="12" Classes="secondary" VerticalAlignment="Center"
                     IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsDayEmpty}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- ============ 下一节课组件：标签 + 首字大字 + 时间小字 ============ -->
    <DataTemplate DataType="{x:Type vm:NextClassCapsuleViewModel}" x:DataType="vm:NextClassCapsuleViewModel">
      <Border Classes="capsule" ToolTip.Tip="拖拽可调整组件顺序"
              PointerPressed="Capsule_PointerPressed"
              PointerMoved="Capsule_PointerMoved"
              PointerReleased="Capsule_PointerReleased"
              PointerCaptureLost="Capsule_PointerCaptureLost">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center"
                    IsVisible="{Binding HasNext}">
          <TextBlock Text="下一节" FontSize="11.5" Classes="secondary" VerticalAlignment="Center" />
          <TextBlock Text="{Binding InitialText}" FontSize="21" FontWeight="Bold"
                     Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding NameText}" FontSize="12" FontWeight="Medium"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       MaxWidth="96" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding TimeText}" FontSize="11" Classes="secondary" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- ============ 天气组件：图标 + 温度大字 ============ -->
    <DataTemplate DataType="{x:Type vm:WeatherCapsuleViewModel}" x:DataType="vm:WeatherCapsuleViewModel">
      <Border Classes="capsule" ToolTip.Tip="{Binding City}"
              PointerPressed="Capsule_PointerPressed"
              PointerMoved="Capsule_PointerMoved"
              PointerReleased="Capsule_PointerReleased"
              PointerCaptureLost="Capsule_PointerCaptureLost">
        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <Path Data="{Binding IconGeometry}" Fill="{DynamicResource PrimaryTextBrush}"
                Width="20" Height="20" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Text}" FontSize="19" FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </DataTemplate>

  </Window.DataTemplates>

  <Window.Resources>
    <!-- 顶栏课程流单项：已结束=首字淡化；进行中=科目名大字+倒计时圆条+底部进度条；未上=首字 -->
    <DataTemplate x:Key="FlowLessonTemplate" x:DataType="vm:LessonCardViewModel">
      <StackPanel Orientation="Horizontal" Classes.flowitem="True" Classes.past="{Binding IsPast}">
        <Rectangle Classes="flowsep" IsVisible="{Binding !IsFirst}" Margin="0,0,14,0" />
        <Grid RowDefinitions="Auto,Auto" Margin="0,0,14,0" VerticalAlignment="Center">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <Panel VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="Bold"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         IsVisible="{Binding IsCurrent}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Initial}" FontSize="21" FontWeight="SemiBold"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         IsVisible="{Binding !IsCurrent}" VerticalAlignment="Center" />
            </Panel>
            <Border Classes="countdown" IsVisible="{Binding IsCurrent}" VerticalAlignment="Center">
              <TextBlock Text="{Binding CurrentCountdown}" FontSize="11.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentBrush}" />
            </Border>
          </StackPanel>
          <ProgressBar Grid.Row="1" Minimum="0" Maximum="1" Value="{Binding Progress}"
                       IsVisible="{Binding IsCurrent}" Height="3" MinWidth="0"
                       CornerRadius="1.5" Margin="0,4,0,0"
                       Foreground="{DynamicResource AccentBrush}" />
        </Grid>
      </StackPanel>
    </DataTemplate>

    <!-- 日视图课程卡 -->
    <DataTemplate x:Key="DayLessonTemplate" x:DataType="vm:LessonCardViewModel">
      <Border Classes="lesson" Classes.current="{Binding IsCurrent}" Classes.past="{Binding IsPast}">
        <StackPanel>
          <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     MaxWidth="102" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding TimeRange}" FontSize="10.5" Classes="secondary" Margin="0,2,0,0" />
          <TextBlock Text="{Binding Detail}" FontSize="10.5" Classes="secondary" Margin="0,2,0,0"
                     MaxHeight="28" TextWrapping="Wrap" />
          <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="3" CornerRadius="2"
                       Margin="0,6,0,0" IsVisible="{Binding IsCurrent}" />
          <TextBlock Text="已结束" FontSize="10" Classes="secondary" Margin="0,6,0,0"
                     IsVisible="{Binding IsPast}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- 周视图迷你课程卡 -->
    <DataTemplate x:DataType="vm:LessonCardViewModel" x:Key="MiniLessonTemplate">
      <Border Classes="minilesson" Classes.current="{Binding IsCurrent}" Classes.past="{Binding IsPast}"
              ToolTip.Tip="{Binding TimeRange}">
        <StackPanel>
          <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Medium"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     MaxWidth="82" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Source.StartTime}" FontSize="10" Classes="secondary" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- 周视图列 -->
    <DataTemplate x:DataType="vm:DayColumnViewModel" x:Key="WeekDayTemplate">
      <Border Width="104" Classes="daycol" Classes.today="{Binding IsToday}">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding DayName}" FontSize="12" FontWeight="SemiBold"
                       Classes.todayname="{Binding IsToday}" />
            <TextBlock Text="{Binding DateText}" FontSize="11" Classes="secondary" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Lessons}" Margin="0,3,0,0"
                        ItemTemplate="{StaticResource MiniLessonTemplate}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Border x:Name="RootBorder" Classes="island"
          Background="{DynamicResource IslandBgBrush}"
          BorderBrush="{DynamicResource IslandBorderBrush}"
          BoxShadow="0 8 32 0 #2E000000"
          ClipToBounds="True">
    <Panel>
      <!-- 亚克力毛玻璃背景 -->
      <ExperimentalAcrylicBorder x:Name="Acrylic" IsHitTestVisible="False">
        <ExperimentalAcrylicBorder.Material>
          <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                       TintColor="#FFF6F8FB"
                                       TintOpacity="0.55"
                                       MaterialOpacity="0.55" />
        </ExperimentalAcrylicBorder.Material>
      </ExperimentalAcrylicBorder>

      <Grid Margin="16,9" RowDefinitions="Auto,Auto">
        <!-- ============ 顶栏：ClassIsland 组件条（大字时间 / 课程流 / 下一节 / 天气） ============ -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
          <ItemsControl x:Name="CapsuleHost" Grid.Column="0"
                        ItemsSource="{Binding Capsules}"
                        VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>

          <Button x:Name="ExpandButton" Grid.Column="1" Classes="expand"
                  Classes.expanded="{Binding IsExpanded}"
                  Command="{Binding ToggleExpandCommand}"
                  VerticalAlignment="Center"
                  ToolTip.Tip="展开 / 收起课表">
            <Path Data="{StaticResource MdiChevronDown}" Fill="{DynamicResource PrimaryTextBrush}"
                  Width="15" Height="15" />
          </Button>
        </Grid>

        <!-- ============ 展开面板：今天 / 本周 ============ -->
        <StackPanel Grid.Row="1" IsVisible="{Binding IsExpanded}" Margin="0,10,0,4" Spacing="8">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
            <ToggleButton Classes="viewtoggle" Content="今天"
                          IsChecked="{Binding IsDayView, Mode=TwoWay}"
                          Command="{Binding ShowDayCommand}" />
            <ToggleButton Classes="viewtoggle" Content="本周"
                          IsChecked="{Binding !IsDayView, Mode=TwoWay}"
                          Command="{Binding ShowWeekCommand}" />
          </StackPanel>

          <!-- 日视图 -->
          <ScrollViewer IsVisible="{Binding IsDayView}"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <Panel Margin="0,2">
              <ItemsControl ItemsSource="{Binding TodayLessons}"
                            ItemTemplate="{StaticResource DayLessonTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <TextBlock Text="今天没有课程" FontSize="12" Classes="secondary"
                         HorizontalAlignment="Center" Margin="0,20"
                         IsVisible="{Binding IsDayEmpty}" />
            </Panel>
          </ScrollViewer>

          <!-- 周视图 -->
          <ScrollViewer IsVisible="{Binding !IsDayView}"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto" MaxHeight="420">
            <ItemsControl ItemsSource="{Binding WeekDays}"
                          ItemTemplate="{StaticResource WeekDayTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <!-- ============ 提醒 Toast ============ -->
        <Border Grid.Row="0" Grid.RowSpan="2" Classes="toast"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                IsVisible="{Binding ToastVisible}" IsHitTestVisible="False">
          <TextBlock Text="{Binding ToastText}" FontSize="12" Foreground="White" />
        </Border>
      </Grid>
    </Panel>
  </Border>
</Window>
