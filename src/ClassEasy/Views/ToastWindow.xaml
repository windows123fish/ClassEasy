<Window x:Class="ClassEasy.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Border x:Name="ToastBorder" Background="#1A202C" CornerRadius="0"
            Padding="24,16" Opacity="1">
        <TextBlock x:Name="ToastText" FontSize="14" Foreground="#FFFFFF"
                   FontWeight="Bold"
                   FontFamily="Microsoft YaHei UI" />
    </Border>
</Window>
