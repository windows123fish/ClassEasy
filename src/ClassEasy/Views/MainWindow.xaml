<Window x:Class="ClassEasy.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClassEasy.Views"
        xmlns:vm="clr-namespace:ClassEasy.ViewModels"
        Title="ClassEasy"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        SourceInitialized="Window_SourceInitialized"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.InputBindings>
        <KeyBinding Key="T" Modifiers="Ctrl+Alt" Command="local:MainWindow.ToggleClickThroughCommand" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="local:MainWindow.ToggleClickThroughCommand" Executed="OnToggleClickThroughExecuted" />
    </Window.CommandBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <local:StringToVisibilityConverter x:Key="StringToVis" />
    </Window.Resources>

    <!--
        磨砂玻璃质感顶栏
        1) Win11 走 DWM Acrylic 系统特效（最正点的"磨砂"，自动启用）
        2) Win7-10 / 失败时回退：半透明白渐变 + 淡描边，自己也能看出"磨砂"感
        渐变故意压得偏淡，让系统 Acrylic 透出来；旧系统上没有系统特效，仅靠透明度也能凑合。
    -->
    <Border x:Name="RootBorder"
            BorderBrush="#60C8CED5"
            BorderThickness="1"
            CornerRadius="0"
            Padding="14,8"
            Background="{Binding BackdropBrush}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <!-- 1. 星期 -->
            <TextBlock Text="{Binding CurrentWeekText}"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="Black"
                       VerticalAlignment="Center" />

            <TextBlock Text=" | " FontSize="22" Foreground="#9099A3" VerticalAlignment="Center" />

            <!-- 2. 日期 09/03 -->
            <TextBlock Text="{Binding DateText}"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="Black"
                       VerticalAlignment="Center" />

            <!-- 节假日（如 国庆节），无节日时不占空间 -->
            <TextBlock Text="{Binding HolidayText}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#E53E3E"
                       VerticalAlignment="Center"
                       Margin="4,0,0,0"
                       Visibility="{Binding HolidayText, Converter={StaticResource StringToVis}}" />

            <!-- 当前课段：有课时显示，无课时整段隐藏 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding IsCurrentLessonEmpty, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text=" | " FontSize="22" Foreground="#9099A3" VerticalAlignment="Center" />
                <TextBlock Text="当前：" FontSize="14" Foreground="#5C6672" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CurrentLessonText}"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="Black"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="240" />
            </StackPanel>

            <!-- 下一节段：有课时显示，无课时整段隐藏 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding IsNextLessonEmpty, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text=" | " FontSize="22" Foreground="#9099A3" VerticalAlignment="Center" />
                <TextBlock Text="下一节：" FontSize="14" Foreground="#5C6672" VerticalAlignment="Center" />
                <TextBlock Text="{Binding NextLessonName}"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="Black"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="200" />
            </StackPanel>

            <TextBlock Text=" | " FontSize="22" Foreground="#9099A3" VerticalAlignment="Center" />

            <!-- 5. 大电子钟（黑字粗体） -->
            <TextBlock Text="{Binding CurrentTime}"
                       FontSize="32"
                       FontWeight="Bold"
                       FontFamily="Consolas,Microsoft YaHei UI"
                       Foreground="Black"
                       VerticalAlignment="Center" />

            <TextBlock Text=" | " FontSize="22" Foreground="#9099A3" VerticalAlignment="Center" />

            <!-- 6. 天气 -->
            <TextBlock Text="☀ "
                       FontSize="16"
                       Foreground="#F5A623"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding WeatherText}"
                       FontSize="14"
                       Foreground="Black"
                       VerticalAlignment="Center" />

            <!-- 7. 授时状态（同步失败时才显示） -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding ClockStatusText, Converter={StaticResource StringToVis}}">
                <TextBlock Text=" | " FontSize="22" Foreground="#9099A3" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ClockStatusText}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="Black"
                           VerticalAlignment="Center" />
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
