<Application x:Class="ClassEasy.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Application.Resources>
        <!-- 默认主题（蓝色）。首次运行或加载失败时生效，随后会被 ThemeService.Apply 覆盖。 -->
        <SolidColorBrush x:Key="Brush.CardBackground" Color="#F2FFFFFF" />
        <SolidColorBrush x:Key="Brush.CardBorder" Color="#DD4A6CF7" />
        <SolidColorBrush x:Key="Brush.TitleText" Color="#2D3748" />
        <SolidColorBrush x:Key="Brush.TimeText" Color="#4A6CF7" />
        <SolidColorBrush x:Key="Brush.LessonCardBackground" Color="#334A6CF7" />
        <SolidColorBrush x:Key="Brush.LessonCardLabel" Color="#8899DD" />
        <SolidColorBrush x:Key="Brush.LessonCardText" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Brush.LessonCardDetail" Color="#DDE6FF" />
        <SolidColorBrush x:Key="Brush.SecondaryText" Color="#718096" />

        <FontFamily x:Key="Font.AppFamily">Microsoft YaHei UI</FontFamily>
        <sys:Double x:Key="Double.TimeFontSize">40</sys:Double>
    </Application.Resources>
</Application>