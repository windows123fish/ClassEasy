<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClassEasy.Controls.LessonCard"
             xmlns:vm="using:ClassEasy.ViewModels"
             x:DataType="vm:LessonCardViewModel"
             VerticalAlignment="Center"
             Opacity="{Binding CardOpacity}">

    <!-- 课程卡片 -->
    <Grid Margin="2,0">

        <!-- 当前课程：显示完整信息 -->
        <StackPanel Orientation="Horizontal" Spacing="4"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsCurrent}">
            <!-- 科目颜色条 -->
            <Border Width="3" Height="28"
                    Background="{Binding SubjectColor}"
                    CornerRadius="2"
                    VerticalAlignment="Center" />

            <StackPanel Orientation="Vertical" Spacing="1"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding SubjectName}"
                           FontSize="14" FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding TimeInfo}"
                           FontSize="10"
                           Foreground="White" Opacity="0.6"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- 进度条 -->
            <Border Width="40" Height="3"
                    Background="#22FFFFFF"
                    CornerRadius="2"
                    VerticalAlignment="Bottom"
                    Margin="4,0,0,4">
                <Border Width="{Binding ProgressWidth}"
                        Height="3"
                        Background="{Binding SubjectColor}"
                        CornerRadius="2"
                        HorizontalAlignment="Left" />
            </Border>
        </StackPanel>

        <!-- 非当前课程：只显示首字母 -->
        <Border Width="28" Height="28"
                Background="{Binding SubjectColor}"
                CornerRadius="14"
                VerticalAlignment="Center"
                IsVisible="{Binding !IsCurrent}">
            <TextBlock Text="{Binding SubjectInitial}"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

    </Grid>
</UserControl>
