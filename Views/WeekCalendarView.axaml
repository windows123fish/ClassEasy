<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClassEasy.Views.WeekCalendarView"
        Title="周历视图"
        Width="900" Height="600"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E"
        Foreground="White">

    <Grid Margin="16" RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="本周课表" FontSize="18" FontWeight="Bold"
                   Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                <!-- 周一到周日 -->
                <Border Grid.Column="0" BorderBrush="#33FFFFFF" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <TextBlock Text="周一" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,4" />
                        <ItemsControl x:Name="MonItems" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" BorderBrush="#33FFFFFF" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <TextBlock Text="周二" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,4" />
                        <ItemsControl x:Name="TueItems" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" BorderBrush="#33FFFFFF" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <TextBlock Text="周三" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,4" />
                        <ItemsControl x:Name="WedItems" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" BorderBrush="#33FFFFFF" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <TextBlock Text="周四" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,4" />
                        <ItemsControl x:Name="ThuItems" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" BorderBrush="#33FFFFFF" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <TextBlock Text="周五" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,4" />
                        <ItemsControl x:Name="FriItems" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="5" BorderBrush="#33FFFFFF" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <TextBlock Text="周六" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,4" />
                        <ItemsControl x:Name="SatItems" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" BorderBrush="#33FFFFFF" BorderThickness="0,0,0,0">
                    <StackPanel>
                        <TextBlock Text="周日" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,4" />
                        <ItemsControl x:Name="SunItems" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
